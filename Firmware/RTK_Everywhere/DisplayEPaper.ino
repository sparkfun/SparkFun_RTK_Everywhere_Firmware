// Other screens
//----------------------------------------

// Setup menu (function button): four rows that fill the screen, Terminus 24 (Terminus 20 for a
// long name). The selected button is a black bar with white text. The bar moves down the rows as
// the button is pressed, and the list only scrolls once the bar reaches the bottom row.
void epPaintSetupMenu(std::vector<setupButton> *buttons, uint8_t selected)
{
    const uint8_t rows = 4;
    const uint8_t rowHeight = 22;
    const uint8_t width = theDisplay->getWidth();
    if (buttons->size() == 0)
        return;

    // First button shown: keep the selected button on screen, scrolling as little as possible
    static uint8_t top = 0;
    if (selected < top)
        top = selected; // Wrapped back to the start, or moved up
    else if (selected >= top + rows)
        top = selected - (rows - 1);

    for (uint8_t row = 0; (row < rows) && (top + row < buttons->size()); row++)
    {
        const setupButton &button = (*buttons)[top + row];
        char name[20];
        printProfileName(&button, name, sizeof(name));

        const epFont_t *font = &epFontText24;
        uint8_t baseline = row * rowHeight + 17;
        uint8_t textWidth = epTextWidth(font, name) - 1;
        if (textWidth > width - 8)
        {
            font = &epFontText20;
            baseline = row * rowHeight + 16;
            textWidth = epTextWidth(font, name) - 1;
        }
        uint8_t x = (button.newState == STATE_PROFILE) ? 4 : (width - textWidth) / 2;
        bool selectedRow = (top + row == selected);
        if (selectedRow)
            theDisplay->rectangleFill(0, row * rowHeight, width, rowHeight, 1);
        epPrintText(x, baseline, font, name, selectedRow);
    }
}
