/*=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
DisplayEPaper.ino

  Rover and base status screens for the 184x88 e-paper display (Facet FP). The OLEDs keep the
  paint*() functions in Display.ino.

  Layout (Firmware/Tools/EPaper_Emulator/epaper_redesign_plan.md, after Juan Cortes's proposal):

      rows  0-15   Top strip, white on black: fix state word, Bluetooth ID (hidden while a phone
                   is connected) and a small battery
      row   17     Heartbeat line, grows through each minute in 10 s steps
      rows 21-60   Accuracy as one big number in mm, cm or m (rover), or the base link state
      rows 27-54   Satellite and count, always at the right
      rows 64-87   Fixed spots: connections | corrections | device | recording. An empty spot
                   stays empty, so nothing moves when an icon comes or goes

  Nothing blinks. White on black only cleans up with a full update (partial updates leave
  outlines of the previous words), so every change of the strip asks for one, rate limited by
  HYBRID_DISPLAY::fixStateChanged().

  Icons are in icons_epaper.h and fonts in fontEPaper.h, both generated by
  Tools/EPaper_Emulator/export_epaper.py.
=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=*/

// Screen geometry
static const uint8_t epStripHeight = 16;
static const uint8_t epStripBaseline = 14;    // Capitals on rows 1-13
static const uint8_t epStripWordX = 4;        // Cell of the first letter
static const uint8_t epStripIdX = 101;        // Cell of the first ID character
static const uint8_t epBatteryX = 161;        // Battery, inside the strip
static const uint8_t epBatteryY = 2;
static const uint8_t epHeartbeatY = 17;       // Rows 17-18
static const uint8_t epHeartbeatHeight = 2;
static const uint8_t epBigX = 2;              // First digit cell
static const uint8_t epBigBaseline = 61;      // Digits on rows 21-60
static const uint8_t epUnitGap = 5;           // Blank columns between the last digit's ink and the unit's
static const uint8_t epSatelliteX = 128;
static const uint8_t epSatelliteY = 27;
static const uint8_t epCountX = 159;          // Satellite count cell
static const uint8_t epCountBaseline = 49;    // Digits on rows 34-48
static const uint8_t epBottom = 85;           // Last row of the bottom icons
static const uint8_t epArrowCenterY = 78;     // Short icons center on the arrows
static const uint8_t epBluetoothX = 2;        // Connections
static const uint8_t epWifiCenterX = 28;
static const uint8_t epEspNowX = 43;
static const uint8_t epArrowX = 66;           // Corrections
static const uint8_t epSourceX = 82;
static const uint8_t epSourceMaxX = 122;
static const uint8_t epSourceGap = 2;         // Between base link icons
static const uint8_t epCasterIpX = 28;        // BASECAST: the IP address after the WiFi icon
static const uint8_t epDeviceX = 124;         // Device
static const uint8_t epWriteDotX = 159;       // Recording
static const uint8_t epWriteDotY = 74;
static const uint8_t epLogX = 168;
static const uint8_t epLogY = 68;

static const unsigned long epTrafficTimeout_ms = 5000; // Arrows stay on this long after RTCM moves
static const unsigned long epNoDataAge_ms = 5000;      // Position older than this shows NO DATA
static const unsigned long epRtcmStalled_ms = 10000;   // Base: no RTCM for this long is NO RTCM

//----------------------------------------
// Drawing
//----------------------------------------

const epGlyph_t *epFindGlyph(const epFont_t *font, char character)
{
    for (uint8_t g = 0; g < font->glyphCount; g++)
        if (font->glyphs[g].character == character)
            return &font->glyphs[g];
    return nullptr;
}

// Width in pixels of text, from the first cell to the end of the last glyph's advance
uint8_t epTextWidth(const epFont_t *font, const char *text)
{
    uint16_t width = 0;
    for (size_t i = 0; text[i]; i++)
    {
        const epGlyph_t *glyph = epFindGlyph(font, text[i]);
        if (glyph)
            width += glyph->advance;
    }
    return (width > 255) ? 255 : width;
}

// Print text with its baseline at y (the row just below the letters). x is the left edge of the
// first character cell. Returns x past the last character's advance.
uint8_t epPrint(uint8_t x, uint8_t baseline, const epFont_t *font, const char *text)
{
    return epPrintText(x, baseline, font, text, false);
}

// epPrint(), and whiteOnBlack XORs the glyphs so they come out white over black
uint8_t epPrintText(uint8_t x, uint8_t baseline, const epFont_t *font, const char *text, bool whiteOnBlack)
{
    if (whiteOnBlack)
        theDisplay->setDrawMode(grROPXOR, grEpROPXOR);
    for (size_t i = 0; text[i]; i++)
    {
        const epGlyph_t *glyph = epFindGlyph(font, text[i]);
        if (glyph == nullptr)
            continue;
        if (glyph->bitmap)
            displayBitmap(x + glyph->xOffset, baseline - font->ascent + glyph->top, glyph->width, glyph->height,
                          glyph->bitmap);
        x += glyph->advance;
    }
    if (whiteOnBlack)
        theDisplay->setDrawMode(grROPCopy, grEpROPCopy);
    return x;
}

// Print text with 1 px between the glyphs' ink instead of the font's spacing, and 1 px either
// side of narrow glyphs such as '.' (IP addresses)
uint8_t epPrintTight(uint8_t x, uint8_t baseline, const epFont_t *font, const char *text)
{
    for (size_t i = 0; text[i]; i++)
    {
        const epGlyph_t *glyph = epFindGlyph(font, text[i]);
        if ((glyph == nullptr) || (glyph->bitmap == nullptr))
            continue;
        uint8_t pad = (glyph->width <= 3) ? 1 : 0;
        displayBitmap(x + pad, baseline - font->ascent + glyph->top, glyph->width, glyph->height, glyph->bitmap);
        x += glyph->width + 1 + 2 * pad;
    }
    return x;
}

void epIcon(const epIcon_t &icon, uint8_t x, uint8_t y, bool whiteOnBlack = false)
{
    if (whiteOnBlack)
        theDisplay->setDrawMode(grROPXOR, grEpROPXOR);
    displayBitmap(x, y, icon.width, icon.height, icon.bitmap);
    if (whiteOnBlack)
        theDisplay->setDrawMode(grROPCopy, grEpROPCopy);
}

// Bottom row icon: tall icons stand on the bottom row, short ones center on the arrows
void epBottomIcon(const epIcon_t &icon, uint8_t x)
{
    uint8_t y = (icon.height >= epIcon_arrowDown.height) ? epBottom + 1 - icon.height
                                                         : epArrowCenterY - icon.height / 2;
    epIcon(icon, x, y);
}

//----------------------------------------
// State
//----------------------------------------

// True while the GNSS is online but its position has stopped updating
bool epNoData()
{
    if (dtActive())
        return dtScenario()->noData;
    return online.gnss && (gnss->getFixAgeMilliseconds() > epNoDataAge_ms);
}

// The word in the top strip
const char *epStripWord(SystemState state, bool noOutput)
{
    switch (state)
    {
    case STATE_ROVER_NO_FIX:
        return epNoData() ? "NO DATA" : "NO FIX";
    case STATE_ROVER_FIX:
        if (epNoData())
            return "NO DATA";
        return dtPppConverging() ? "PPP" : "GNSS";
    case STATE_ROVER_RTK_FLOAT:
        if (epNoData())
            return "NO DATA";
        if (dtPppConverged())
            return "PPP FIX";
        return dtPppConverging() ? "PPP" : "RTK FLOAT";
    case STATE_ROVER_RTK_FIX:
        return epNoData() ? "NO DATA" : "RTK FIX";
    case STATE_BASE_TEMP_SETTLE:
    case STATE_BASE_TEMP_SURVEY_STARTED:
        return "SURVEY-IN";
    case STATE_BASE_TEMP_TRANSMITTING:
        if (noOutput)
            return "NO OUTPUT";
        return dtBaseCasterOverride() ? "BASECAST" : "TEMP BASE";
    case STATE_BASE_FIXED_TRANSMITTING:
        return noOutput ? "NO OUTPUT" : "BASE";
    default:
        return "";
    }
}

// Battery icon level 0-3, or -1 when there is no battery to show
int epBatteryLevel()
{
    if (!dtHasBattery())
        return -1;
    int percent = dtBatteryPercent();
    if (percent >= 75)
        return 3;
    if (percent >= 50)
        return 2;
    if (percent >= 25)
        return 1;
    return 0;
}

// Corrections arriving (rover) or RTCM leaving (base) recently. The per-source flags are set by
// the transports and cleared here, as the OLED code does.
bool epCorrectionsArriving()
{
    static unsigned long lastSeen = 0;
    if (dtActive())
        return dtScenario()->arrowDown;
    if (bluetoothIncomingRTCM || espNowIncomingRTCM || usbSerialIncomingRtcm || netIncomingRTCM ||
        mqttClientDataReceived)
    {
        lastSeen = millis();
        bluetoothIncomingRTCM = false;
        espNowIncomingRTCM = false;
        usbSerialIncomingRtcm = false;
        netIncomingRTCM = false;
        mqttClientDataReceived = false;
    }
    return (lastSeen != 0) && ((millis() - lastSeen) < epTrafficTimeout_ms);
}

bool epRtcmLeaving()
{
    if (dtActive())
        return dtScenario()->arrowUp;
    bluetoothOutgoingRTCM = false;
    espNowOutgoingRTCM = false;
    netOutgoingRTCM = false;
    return (rtcmLastPacketSent != 0) && ((millis() - rtcmLastPacketSent) < epTrafficTimeout_ms);
}

// Base: the links that can carry RTCM out of the unit (epBaseLinks_t is in Display.h)
epBaseLinks_t epBaseLinks()
{
    epBaseLinks_t links;
    links.bluetooth = dtBtConnected();
    links.espNow = dtBroadcastIsActive(BCAST_ESPNOW);
    links.lora = dtBroadcastIsActive(BCAST_RADIO_LORA);
    links.ntripServer = dtBroadcastIsActive(BCAST_NTRIP_SERVER);
    links.tcpServer = dtBroadcastIsActive(BCAST_NTRIP_CASTER);
    return links;
}

bool epAnyLink(const epBaseLinks_t &links)
{
    return links.bluetooth || links.espNow || links.lora || links.ntripServer || links.tcpServer;
}

// Format the accuracy (m) as digits and a unit. Round first, then pick the unit, so 0.995 m is
// 1.0 m (not 100 cm) and nothing grows past three digit cells. False when there is no value.
bool epFormatAccuracy(float meters, char *digits, size_t digitsSize, const char **unit)
{
    if (!(meters > 0)) // Also catches NaN
        return false;
    long millimeters = lroundf(meters * 1000);
    long centimeters = lroundf(meters * 100);
    long decimeters = lroundf(meters * 10);
    if (millimeters < 100)
    {
        snprintf(digits, digitsSize, "%ld", (millimeters < 1) ? 1 : millimeters);
        *unit = "mm";
    }
    else if (centimeters < 100)
    {
        snprintf(digits, digitsSize, "%ld", centimeters);
        *unit = "cm";
    }
    else if (decimeters < 100)
    {
        snprintf(digits, digitsSize, "%ld.%ld", decimeters / 10, decimeters % 10);
        *unit = "m";
    }
    else if (meters <= 30)
    {
        snprintf(digits, digitsSize, "%ld", lroundf(meters));
        *unit = "m";
    }
    else
    {
        snprintf(digits, digitsSize, ">30");
        *unit = "m";
    }
    return true;
}

// RTCM packets sent, shortened to fit: 999, 1k, 12k, 1M
void epFormatCount(uint32_t count, char *buffer, size_t bufferSize)
{
    if (count < 1000)
        snprintf(buffer, bufferSize, "%lu sent", (unsigned long)count);
    else if (count < 1000000)
        snprintf(buffer, bufferSize, "%luk sent", (unsigned long)(count / 1000));
    else
        snprintf(buffer, bufferSize, "%luM sent", (unsigned long)(count / 1000000));
}

//----------------------------------------
// Screen parts
//----------------------------------------

// Black strip with the word, the Bluetooth ID while no phone is connected, and the battery.
// Returns a hash of what it shows, so a change can ask for a full update.
uint32_t epPaintStrip(const char *word)
{
    theDisplay->rectangleFill(0, 0, theDisplay->getWidth(), epStripHeight, 1);
    epPrintText(epStripWordX, epStripBaseline, &epFontText20, word, true);

    // The Bluetooth ID: four characters of the Bluetooth MAC and two of the product (assembleDeviceName())
    bool showId = !dtBtConnected();
    if (showId)
        epPrintText(epStripIdX, epStripBaseline, &epFontText20, serialNumber, true);

    int battery = epBatteryLevel();
    static const epIcon_t *const batteries[] = {&epIcon_battery0, &epIcon_battery1, &epIcon_battery2,
                                                &epIcon_battery3};
    if (battery >= 0)
        epIcon(*batteries[battery], epBatteryX, epBatteryY, true);

    uint32_t hash = 2166136261UL;
    for (size_t i = 0; word[i]; i++)
        hash = (hash ^ (uint8_t)word[i]) * 16777619UL;
    hash = (hash ^ (showId ? 1 : 0)) * 16777619UL;
    hash = (hash ^ (uint8_t)(battery + 1)) * 16777619UL;
    return hash;
}

// A 1 px line under the strip that grows through each minute in 10 s steps, so a working unit
// can be told from a frozen one
void epPaintHeartbeat()
{
    uint8_t step = (millis() / 10000) % 6;
    theDisplay->rectangleFill(0, epHeartbeatY, (theDisplay->getWidth() * (step + 1)) / 6, epHeartbeatHeight, 1);
}

// Satellite and count at the right. The satellite has a P tile with PPP on, and a slash for an
// antenna short or open.
void epPaintSatellites()
{
    const epIcon_t *icon = &epIcon_satellite;
    bool fault = dtSupportsAntennaShortOpen() && (dtAntennaShorted() || dtAntennaOpen());
    if (fault)
        icon = &epIcon_satelliteFault;
    else if (dtPppIcon())
        icon = &epIcon_satellitePpp;
    epIcon(*icon, epSatelliteX, epSatelliteY);

    char count[4];
    snprintf(count, sizeof(count), "%d", fault ? 0 : dtSatellitesInView());
    epPrint(epCountX, epCountBaseline, &epFontCount, count);
}

// Big accuracy number and its unit, with the tilt icon above the unit. "---" without a value.
void epPaintAccuracy(bool showValue)
{
    char digits[8];
    const char *unit = nullptr;
    if (!showValue || !epFormatAccuracy(dtHorizontalAccuracy(), digits, sizeof(digits), &unit))
    {
        for (uint8_t cell = 0; cell < 3; cell++)
            theDisplay->rectangleFill(epBigX + cell * 28, 39, 24, 4, 1);
        return;
    }

    // Digit cells are 24 px wide on a 28 px pitch; '.' takes 8
    uint8_t x = epBigX;
    uint8_t inkEnd = x;
    for (size_t i = 0; digits[i]; i++)
    {
        const epGlyph_t *glyph = epFindGlyph(&epFontBig, digits[i]);
        if (glyph == nullptr)
            continue;
        char text[2] = {digits[i], 0};
        epPrint(x, epBigBaseline, &epFontBig, text);
        inkEnd = x + glyph->xOffset + glyph->width;
        x += glyph->advance;
    }

    // Unit ink starts epUnitGap past the last digit's ink, the tilt icon above it
    uint8_t unitInkX = inkEnd + epUnitGap;
    const epGlyph_t *first = epFindGlyph(&epFontUnits, unit[0]);
    epPrint(unitInkX - (first ? first->xOffset : 0), epBigBaseline, &epFontUnits, unit);

    if (dtTiltCorrecting())
        epIcon(epIcon_tilt, unitInkX, 26);
}

// The e-paper icon for the GNSS dynamic model, or nullptr
const epIcon_t *epDynamicModelIcon()
{
    const iconProperties *model = dynamicModelIconProperties();
    static const struct
    {
        const iconProperties *model;
        const epIcon_t *icon;
    } map[] = {
        {&DynamicModel_1_Properties, &epIcon_modelPortable},    {&DynamicModel_2_Properties, &epIcon_modelStationary},
        {&DynamicModel_3_Properties, &epIcon_modelPedestrian},  {&DynamicModel_4_Properties, &epIcon_modelAutomotive},
        {&DynamicModel_5_Properties, &epIcon_modelSea},         {&DynamicModel_6_Properties, &epIcon_modelAirborne},
        {&DynamicModel_7_Properties, &epIcon_modelAirborne},    {&DynamicModel_8_Properties, &epIcon_modelAirborne},
        {&DynamicModel_9_Properties, &epIcon_modelWrist},       {&DynamicModel_10_Properties, &epIcon_modelBike},
        {&DynamicModel_11_Properties, &epIcon_modelMower},      {&DynamicModel_12_Properties, &epIcon_modelScooter},
        {&DynamicModel_Tractor_Props, &epIcon_modelTractor},
    };
    for (auto &entry : map)
        if (entry.model == model)
            return entry.icon;
    return nullptr;
}

// The icon for a corrections source, or nullptr
const epIcon_t *epCorrectionIcon(CORRECTION_ID_T source)
{
    switch (source)
    {
    case CORR_ESPNOW:
        return &epIcon_espNow;
    case CORR_RADIO_LORA:
        return &epIcon_lora;
    case CORR_BLUETOOTH:
        return &epIcon_bluetooth;
    case CORR_USB:
        return &epIcon_usb;
    case CORR_TCP:
        return &epIcon_ntrip;
    case CORR_LBAND:
    case CORR_IP:
        return &epIcon_pointPerfect;
    default:
        return nullptr; // PPP needs no icon - the strip says PPP
    }
}

// The WiFi icon for the signal, or nullptr with WiFi off
const epIcon_t *epWifiIcon()
{
    if (dtWifiStationRunning())
    {
        if (!dtWifiStationInternet())
            return &epIcon_wifiNoInternet;
        if (dtWifiRssi() >= -40) // Same levels as the OLEDs
            return &epIcon_wifi3;
        if (dtWifiRssi() >= -60)
            return &epIcon_wifi2;
        return &epIcon_wifi1; // Weak WiFi never shows a lone dot
    }
    if (dtWifiSoftApRunning())
        return &epIcon_wifi3;
    return nullptr;
}

// Bluetooth, WiFi and ESP-NOW, each in its own spot
void epPaintConnections(bool bluetooth, bool espNow)
{
    if (bluetooth)
        epBottomIcon(epIcon_bluetooth, epBluetoothX);

    const epIcon_t *wifi = epWifiIcon();
    if (wifi)
        epIcon(*wifi, epWifiCenterX - wifi->width / 2, epBottom + 1 - wifi->height);

    if (espNow)
        epBottomIcon(epIcon_espNow, epEspNowX);
}

// Logging: a static page (standard, PPP or custom), a dot while it is writing, and an empty page
// while logging is on but nothing is written
void epPaintRecording()
{
    const epIcon_t *page = nullptr;
    bool writing = false;
    if (dtActive())
    {
        switch (dtScenario()->logging)
        {
        case DT_LOG_STANDARD:
            page = &epIcon_logStandard;
            break;
        case DT_LOG_PPP:
            page = &epIcon_logPpp;
            break;
        case DT_LOG_CUSTOM:
            page = &epIcon_logCustom;
            break;
        case DT_LOG_IDLE:
            page = &epIcon_logIdle;
            break;
        default:
            break;
        }
        writing = (page != nullptr) && (page != &epIcon_logIdle);
    }
    else if (online.logging || (present.mosaicMicroSd && logMosaicIncreasing))
    {
        writing = logIncreasing || ntpLogIncreasing || (present.mosaicMicroSd && logMosaicIncreasing);
        if (!writing)
            page = &epIcon_logIdle;
        else if (loggingType == LOGGING_PPP)
            page = &epIcon_logPpp;
        else if (loggingType == LOGGING_CUSTOM)
            page = &epIcon_logCustom;
        else
            page = &epIcon_logStandard;
    }
    if (page)
        epIcon(*page, epLogX, epLogY);
    if (writing)
        epIcon(epIcon_writeDot, epWriteDotX, epWriteDotY);
}

// Device spot: the battery percentage below 25 %, else the given icon
void epPaintDevice(const epIcon_t *icon)
{
    if (epBatteryLevel() == 0)
    {
        char percent[8];
        snprintf(percent, sizeof(percent), "%d%%", dtBatteryPercent());
        epPrint(epDeviceX, epBottom + 1, &epFontText20, percent);
    }
    else if (icon)
        epBottomIcon(*icon, epDeviceX);
}

//----------------------------------------
// Screens
//----------------------------------------

void epPaintRover(SystemState state)
{
    epPaintAccuracy((state != STATE_ROVER_NO_FIX) && !epNoData());
    epPaintSatellites();

    // ESP-NOW carrying the corrections shows once, as the source
    CORRECTION_ID_T correctionSource = dtCorrectionSource();
    epPaintConnections(dtBtConnected(), dtEspNowPaired() && (correctionSource != CORR_ESPNOW));
    if (epCorrectionsArriving())
        epBottomIcon(epIcon_arrowDown, epArrowX);
    const epIcon_t *source = epCorrectionIcon(correctionSource);
    if (source)
        epBottomIcon(*source, epSourceX);
    epPaintDevice(epDynamicModelIcon());
    epPaintRecording();
}

// Base sending: check, SENDING and the count. Stalled or no links: warning and the reason.
void epPaintBaseHealth(bool noOutput)
{
    bool stalled = dtActive() ? dtScenario()->rtcmStalled
                              : ((rtcmLastPacketSent == 0) || ((millis() - rtcmLastPacketSent) > epRtcmStalled_ms));
    if (!noOutput && !stalled)
    {
        char count[16];
        epFormatCount(dtRtcmPacketsSent(), count, sizeof(count));
        epIcon(epIcon_check, 2, 26);
        epPrint(30, 39, &epFontText20, "SENDING");
        epPrint(30, 58, &epFontText16, count);
        return;
    }

    epIcon(epIcon_warning, 2, 25);
    epPrint(32, 39, &epFontText20, noOutput ? "NO OUTPUT" : "NO RTCM");
    char detail[16];
    if (noOutput)
        snprintf(detail, sizeof(detail), "Add a link");
    else if (dtActive())
        snprintf(detail, sizeof(detail), "for 15 s");
    else if (rtcmLastPacketSent == 0)
        snprintf(detail, sizeof(detail), "none yet");
    else
        snprintf(detail, sizeof(detail), "for %lu s", (millis() - rtcmLastPacketSent) / 1000);
    epPrint(32, 58, &epFontText16, detail);
}

// Survey-in accuracy: meters to 2 places, or millimeters below 0.1 m so RTK-level values don't
// show as 0.00m
void epFormatSurveyAccuracy(const char *label, float meters, char *buffer, size_t bufferSize)
{
    if (meters > 99.99)
        meters = 99.99;
    long millimeters = lroundf(meters * 1000);
    if (millimeters < 100)
        snprintf(buffer, bufferSize, "%s %ldmm", label, (millimeters < 0) ? 0 : millimeters);
    else
        snprintf(buffer, bufferSize, "%s %.2fm", label, meters);
}

// Survey-in: mean and goal accuracy, and the observation time beside a bar that only grows
void epPaintSurveyIn()
{
    char line[20];
    epFormatSurveyAccuracy("MEAN", dtSurveyInMeanAccuracy(), line, sizeof(line));
    epPrint(2, 33, &epFontText20, line);
    epFormatSurveyAccuracy("GOAL", settings.observationPositionAccuracy, line, sizeof(line));
    epPrint(2, 49, &epFontText20, line);

    int seconds = dtSurveyInObservationTime();
    int goal = settings.observationSeconds;
    if (goal < 1)
        goal = 1;
    static int progress = 0; // Pixels - the bar never shrinks during a survey
    int fill = (63 * ((seconds > goal) ? goal : seconds)) / goal;
    if ((fill < progress) && (seconds < 2))
        progress = 0; // New survey
    if (fill > progress)
        progress = fill;
    theDisplay->rectangle(2, 53, 69, 9, 1);
    theDisplay->rectangle(3, 54, 67, 7, 1);
    if (progress > 0)
        theDisplay->rectangleFill(5, 56, progress, 3, 1);
    snprintf(line, sizeof(line), "%d/%ds", seconds, goal);
    epPrint(76, 62, &epFontText16, line);
}

void epPaintBase(SystemState state, const epBaseLinks_t &links, bool noOutput)
{
    if (state == STATE_BASE_TEMP_SETTLE)
        epPaintAccuracy(true); // Waiting for the accuracy to start the survey
    else if (state == STATE_BASE_TEMP_SURVEY_STARTED)
        epPaintSurveyIn();
    else
        epPaintBaseHealth(noOutput);
    epPaintSatellites();

    bool transmitting = (state == STATE_BASE_TEMP_TRANSMITTING) || (state == STATE_BASE_FIXED_TRANSMITTING);
    if (transmitting && dtBaseCasterOverride())
    {
        // BASECAST: rovers connect to this unit, so its IP address stays on the screen. WiFi
        // moves to the left edge and the address takes the corrections and device spots.
        const epIcon_t *wifi = epWifiIcon();
        if (wifi)
            epIcon(*wifi, epBluetoothX, epBottom + 1 - wifi->height);
        char ip[20];
        if (!dtIpAddress(ip, sizeof(ip)))
            snprintf(ip, sizeof(ip), "%s", networkGetIpAddress().toString().c_str());
        epPrintTight(epCasterIpX, epBottom + 1, &epFontText20, ip);
        epPaintRecording();
        return;
    }
    else
    {
        epPaintConnections(links.bluetooth, links.espNow);
        if (transmitting && epRtcmLeaving())
            epBottomIcon(epIcon_arrowUp, epArrowX);

        // The links actually carrying data, left to right
        if (transmitting)
        {
            const epIcon_t *icons[3];
            uint8_t count = 0;
            if (links.lora)
                icons[count++] = &epIcon_lora;
            if (links.ntripServer)
                icons[count++] = &epIcon_ntrip;
            if (links.tcpServer)
                icons[count++] = &epIcon_ntrip;
            uint8_t x = epSourceX;
            for (uint8_t i = 0; i < count; i++)
            {
                if (x + icons[i]->width - 1 > epSourceMaxX)
                    break;
                epBottomIcon(*icons[i], x);
                x += icons[i]->width + epSourceGap;
            }
        }
    }

    epPaintDevice((state == STATE_BASE_FIXED_TRANSMITTING) ? &epIcon_baseFixed : &epIcon_baseTemporary);
    epPaintRecording();
}

// Paint the rover or base status screen. Returns false for the states it doesn't cover, which
// keep the Display.ino screens.
bool epPaintStatus(SystemState state)
{
    bool rover = (state == STATE_ROVER_NO_FIX) || (state == STATE_ROVER_FIX) || (state == STATE_ROVER_RTK_FLOAT) ||
                 (state == STATE_ROVER_RTK_FIX);
    bool base = (state == STATE_BASE_TEMP_SETTLE) || (state == STATE_BASE_TEMP_SURVEY_STARTED) ||
                (state == STATE_BASE_TEMP_TRANSMITTING) || (state == STATE_BASE_FIXED_TRANSMITTING);
    if (!rover && !base)
        return false;

    epBaseLinks_t links = epBaseLinks();
    bool transmitting = (state == STATE_BASE_TEMP_TRANSMITTING) || (state == STATE_BASE_FIXED_TRANSMITTING);
    bool noOutput = transmitting && !epAnyLink(links);

    uint32_t strip = epPaintStrip(epStripWord(state, noOutput));
    epPaintHeartbeat();
    if (rover)
        epPaintRover(state);
    else
        epPaintBase(state, links, noOutput);

    // The white-on-black strip needs a full update to change cleanly. The first status screen
    // after boot gets one straight away, later changes once the rate limit allows.
    static uint32_t previousStrip = 0;
    if (strip != previousStrip)
    {
        if (previousStrip == 0)
            theDisplay->requestFullUpdate();
        else
            theDisplay->fixStateChanged();
        previousStrip = strip;
    }
    return true;
}

