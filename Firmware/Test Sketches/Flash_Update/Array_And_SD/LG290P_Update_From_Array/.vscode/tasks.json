{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Upload",
            "type": "shell",
            // None level of error, no warnings, fast upload
            "command": "arduino-cli --fqbn esp32:esp32:esp32:DebugLevel=none,UploadSpeed=921600,FlashSize=8M compile LG290P_Update_From_Array.ino --build-property upload.maximum_size=4055040 --build-property build.partitions=RTKEverywhere_8MB -p COM26 -u",

            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": false,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Just Upload",
            "type": "shell",
            "command": "arduino-cli upload -p COM26 --fqbn esp32:esp32:esp32:UploadSpeed=921600,FlashSize=8M LG290P_Update_From_Array.ino",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": false,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}